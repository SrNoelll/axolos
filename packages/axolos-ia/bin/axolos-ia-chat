class AxolStyle(Style):
    background_color = C["bg_dark"]
    styles = {
        Text: C["fg"], Comment: "italic #6e6c80", Keyword: C["accent"], Keyword.Type: C["yellow"],
        Name.Function: C["cyan"], Name.Class: C["yellow"], Name.Builtin: C["lilac"],
        Name.Decorator: "#fbe2a6", Name.Tag: C["accent"], Name.Attribute: C["accent_hi"],
        String: C["green"], String.Escape: "#fbe2a6", Number: "#ff9fb0", Operator: C["lilac"],
        Punctuation: C["muted"], Generic.Inserted: C["green"], Generic.Deleted: C["pink"],
        Generic.Heading: "bold " + C["accent"], Error: C["pink"],
    }


CODE_RE = re.compile(r'<pre><code(?: class="language-([\w+#.-]+)")?>(.*?)</code></pre>', re.S)


def md_html(text):
    """Markdown → (HTML que entiende Qt, [bloques de código]) con colores AxolOS."""
    if text.count("```") % 2:          # bloque de código aún abierto (llegando en streaming)
        text += "\n```"
    h = markdown.markdown(text, extensions=["fenced_code", "tables", "sane_lists"])
    codigos = []

    def code(m):
        lang, src = m.group(1) or "", html.unescape(m.group(2)).rstrip("\n")
        codigos.append(src)
        try:
            lexer = get_lexer_by_name(lang) if lang else TextLexer()
        except Exception:
            lexer = TextLexer()
        body = highlight(src, lexer, HtmlFormatter(nowrap=True, noclasses=True, style=AxolStyle))
        n = len(codigos) - 1
        return (f'<table width="100%" cellpadding="0" cellspacing="0" bgcolor="{C["bg_dark"]}" '
                f'style="margin-top:8px;margin-bottom:8px">'
                f'<tr><td bgcolor="{C["code_head"]}" style="padding:5px 12px">'
                f'<span style="color:{C["faint"]};font-size:8.5pt">{html.escape(lang or "texto")}</span></td>'
                f'<td bgcolor="{C["code_head"]}" align="right" style="padding:5px 12px">'
                f'<a href="copiar:{n}" style="color:{C["muted"]};text-decoration:none;font-size:8.5pt">'
                f'Copiar</a></td></tr>'
                f'<tr><td colspan="2" style="padding:10px 12px">'
                f'<pre style="font-family:\'{MONO}\';font-size:9.5pt;margin:0;white-space:pre-wrap">{body}</pre>'
                f'</td></tr></table>')
    h = CODE_RE.sub(code, h)
    h = h.replace("<code>", f'<code style="font-family:\'{MONO}\';background-color:{C["border"]};'
                            f'color:{C["accent_hi"]}">').replace("</code>", "</code>")
    h = h.replace("<table>", f'<table cellpadding="7" cellspacing="0" border="1" '
                             f'style="border-color:{C["border"]};margin-top:6px;margin-bottom:6px">')
    h = re.sub(r"<a href=\"(?!copiar:)", f'<a style="color:{C["accent_hi"]}" href="', h)
    return f'<div style="line-height:145%">{h}</div>', codigos


def rgba(css):
    """#RRGGBBAA (estilo web) → rgba(): Qt leería #AARRGGBB y saldrían otros colores."""
    return re.sub(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})\b",
                  lambda m: "rgba({},{},{},{})".format(*(int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4)),
                                                         int(m.group(2), 16)), css)


