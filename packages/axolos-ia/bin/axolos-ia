#!/usr/bin/env python3
"""axolos-ia · IA local de AxolOS (ayuda traducida: axolos-ia --help)."""
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.environ.get("AXOLOS_LIB", "/usr/lib/axolos"))
import axolos_ia as ia  # noqa: E402
sys.path.insert(0, os.environ.get("AXOLOS_LIB", "/usr/lib/axolos"))
try:
    from axolos_i18n import _, elegir, idioma  # noqa: E402  textos en el idioma del sistema
except ImportError:                             # sin axolos-branding: textos originales
    def _(texto):
        return texto

    def elegir(textos):
        return textos.get("es", "") if isinstance(textos, dict) else textos

    def idioma():
        return "es"

M, G, V, R, B, F = ("\033[38;2;166;154;254m", "\033[38;2;138;138;153m", "\033[38;2;125;223;180m",
                    "\033[38;2;255;122;147m", "\033[1m", "\033[0m")
WEBUI_IMG = "ghcr.io/open-webui/open-webui:main"


def ok(b):
    return f"{V}✓{F}" if b else f"{R}✗{F}"


def estado():
    hw = ia.hardware()
    ver = ia.servidor_ok()
    print(_("{M}{B}IA local de AxolOS{F}\n").format(M=M, B=B, F=F))
    gpu = _("{0} · {1} GB de VRAM").format(hw['gpu'], hw['vram_gb']) if hw["gpu"] else _("sin gráfica dedicada")
    print(_("  Gráfica     {gpu}").format(gpu=gpu))
    print(_("  Aceleración {0} {1}").format(ok(hw['backend_ok']), hw['backend'])
          + ("" if hw["backend_ok"] else _("   {G}→ actívala con: axolos-ia gpu{F}").format(G=G, F=F)))
    print(_("  Servicio    {0} ").format(ok(ver)) + (f"Ollama {ver}" if ver else _("apagado   {G}→ axolos-ia gpu{F}").format(G=G, F=F)))
    if not ver:
        return
    ms = ia.modelos()
    print(_("  Modelos     {0}").format(', '.join(m['name'] for m in ms) or G + _('ninguno → axolos-ia descargar') + F))
    for m in ia.en_memoria():
        donde = "gráfica" if m["vram_gb"] >= m["size_gb"] * 0.95 else _("{0} GB en gráfica, resto en RAM").format(m['vram_gb'])
        print(_("  En uso      {0} ({1} GB, {donde})").format(m['name'], m['size_gb'], donde=donde))
    falta = [r for r in ia.recomendados(hw) if r not in {m["name"] for m in ms}
             and r + ":latest" not in {m["name"] for m in ms}]
    if falta:
        print(_("\n  {G}Recomendados para tu equipo: {0}  →  axolos-ia descargar{F}").format(' '.join(falta), G=G, F=F))
    try:
        import axolos_buscar
        print(_("  Archivos    {0}").format(axolos_buscar.estado()))
    except Exception:  # noqa: BLE001
        pass
    print(_("\n  {G}Chat: Axo en el menú · Alt+Espacio y escribe «ia tu pregunta» o «ia busco …»{F}").format(G=G, F=F))


def modelos():
    hw = ia.hardware()
    rec, opc = ia.recomendados(hw), ia.opcionales(hw)
    inst = {m["name"].removesuffix(":latest") for m in ia.modelos()}
    print(_("{M}{B}Modelos para la IA local{F}  {G}(tu equipo: {0} GB de VRAM, {1} GB de RAM){F}\n").format(hw['vram_gb'], hw['ram_gb'], M=M, B=B, F=F, G=G))
    for m in ia.CATALOGO:
        mid = m["id"]
        marca = (_("{V}instalado{F}").format(V=V, F=F) if mid in inst else _("{M}recomendado{F}").format(M=M, F=F) if mid in rec
                 else _("{M}opcional{F}").format(M=M, F=F) if mid in opc else "")
        aviso = "" if ia.cabe(mid, hw) else _(" {G}(irá lento en tu equipo){F}").format(G=G, F=F)
        print(f"  {M}{mid:<20}{F}{m['nombre']:<22}{m['gb']:>5.1f} GB  {marca}")
        print(f"  {'':20}{G}{m['uso']}{F}{aviso}")


def barra(pct, ancho=28):
    llenos = int(ancho * pct / 100)
    return f"{M}{'━' * llenos}{G}{'━' * (ancho - llenos)}{F} {pct:3d} %"


def descargar(ids):
    for _intento in range(30):            # recién (re)arrancado: darle unos segundos
        if ia.servidor_ok():
            break
        time.sleep(1)
    else:
        sys.exit(_("La IA local está apagada: ejecuta  axolos-ia gpu"))
    ids = ids or ia.recomendados()
    for mid in ids:
        print(f"{M}==>{F} {ia.nombre_bonito(mid)} ({mid})")
        ultimo = ""
        try:
            for done, total, status in ia.descargar(mid):
                pct = int(done * 100 / total) if total else 0
                linea = f"   {barra(pct)}  {G}{status[:30]}{F}" if total else f"   {G}{status}{F}"
                if linea != ultimo:
                    print("\r\033[K" + linea, end="", flush=True)
                    ultimo = linea
        except RuntimeError as e:
            print(f"\n   {R}{e}{F}")
            continue
        print("\r\x1b[K" + _("   {V}✓ listo{F}").format(V=V, F=F))


def continue_yaml():
    ms = {m["name"].removesuffix(":latest") for m in ia.modelos()}
    rec = ia.recomendados()
    chat = next((r for r in rec if r.startswith("qwen3.5")), rec[0])
    auto = next((r for r in rec if "coder" in r), "qwen2.5-coder:1.5b")
    if chat not in ms or auto not in ms:
        print(_("{G}Aviso: faltan modelos ({0}, {1}); descárgalos con  axolos-ia descargar{F}").format(chat, auto, G=G, F=F))
    return f"""# AxolOS · Continue usa la IA local (Ollama); nada sale de tu equipo
name: AxolOS IA local
version: 1.0.0
schema: v1
models:
  - name: {ia.nombre_bonito(chat)} (local)
    provider: ollama
    model: {chat}
    roles: [chat, edit, apply]
  - name: {ia.nombre_bonito(auto)} (autocompletado)
    provider: ollama
    model: {auto}
    roles: [autocomplete]
  - name: EmbeddingGemma (local)
    provider: ollama
    model: embeddinggemma
    roles: [embed]
"""


def vscode():
    code = next((c for c in ("code", "codium", "code-oss") if shutil.which(c)), None)
    if not code:
        sys.exit(_("No hay VS Code instalado."))
    print(_("{M}==>{F} Extensión Continue en {code}").format(M=M, F=F, code=code))
    subprocess.run([code, "--install-extension", "Continue.continue"], check=False)
    cfg = Path.home() / ".continue/config.yaml"
    if cfg.exists() and "AxolOS" not in cfg.read_text(encoding="utf-8"):
        bak = cfg.with_name(f"config.yaml.antes-de-axolos-{time.strftime('%Y%m%d-%H%M%S')}")
        cfg.rename(bak)
        print(_("   tu configuración anterior está en {bak}").format(bak=bak))
    cfg.parent.mkdir(parents=True, exist_ok=True)
    cfg.write_text(continue_yaml(), encoding="utf-8")
    print(f"   {V}✓{F} " + _("Continue usa la IA local. En VS Code: Ctrl+L para el chat; el autocompletado va solo."))


def web():
    if not shutil.which("docker"):
        sys.exit(_("Necesitas Docker (perfil «contenedores»: axolos-dev instalar contenedores)."))
    existe = subprocess.run(["docker", "container", "inspect", "open-webui"], capture_output=True).returncode == 0
    if existe:
        subprocess.run(["docker", "start", "open-webui"], check=False, stdout=subprocess.DEVNULL)
    else:
        print(_("{M}==>{F} Descargando Open WebUI (solo la primera vez, ~4 GB)").format(M=M, F=F))
        r = subprocess.run(["docker", "run", "-d", "--name", "open-webui", "--restart", "unless-stopped",
                            "--network", "host", "-e", "HOST=127.0.0.1", "-e", "PORT=3000",
                            "-e", f"OLLAMA_BASE_URL={ia.URL}", "-e", "WEBUI_AUTH=False",
                            "-e", "ANONYMIZED_TELEMETRY=False",
                            "-v", "open-webui:/app/backend/data", WEBUI_IMG])
        if r.returncode:
            sys.exit(_("No se pudo arrancar Open WebUI."))
    print(_("   {V}✓{F} Abriendo http://localhost:3000 (tarda unos segundos la primera vez)").format(V=V, F=F))
    for _intento in range(60):
        if subprocess.run(["curl", "-sf", "-o", "/dev/null", "http://127.0.0.1:3000"]).returncode == 0:
            break
        time.sleep(2)
    subprocess.Popen(["xdg-open", "http://localhost:3000"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# Las órdenes se escriben en español o en inglés
ALIAS = {"status": "estado", "models": "modelos", "download": "descargar", "index": "indexar",
         "search": "buscar", "context": "contexto", "help": "ayuda"}


def ayuda():
    return _("""axolos-ia · IA local de AxolOS

  axolos-ia                     estado: gráfica, servicio, modelos
  axolos-ia gpu                 activa la gráfica para la IA (CUDA / ROCm / Vulkan)
  axolos-ia modelos             catálogo y qué conviene a tu equipo
  axolos-ia descargar [ID...]   descarga modelos (sin ID: los recomendados)
  axolos-ia vscode              conecta VS Code con la IA local (extensión Continue)
  axolos-ia web                 interfaz web Open WebUI en http://localhost:3000 (Docker)
  axolos-ia chat                abre Axo, el chat
  axolos-ia contexto            lo que Axo sabe de este equipo (datos en vivo + manual)
  axolos-ia buscar FRASE        busca tus archivos por lo que contienen («foto de la playa»)
  axolos-ia indexar             actualiza ya el índice de archivos (se hace solo cada 30 min)
""")


def main():
    a = sys.argv[1:]
    cmd = ALIAS.get(a[0], a[0]) if a else "estado"
    if cmd == "estado":
        estado()
    elif cmd == "gpu":
        sys.exit(subprocess.run(["pkexec", ia.ROOT_HELPER, "ia-gpu"]).returncode)
    elif cmd == "modelos":
        modelos()
    elif cmd == "descargar":
        descargar(a[1:])
    elif cmd == "vscode":
        vscode()
    elif cmd == "web":
        web()
    elif cmd == "indexar":
        import axolos_buscar
        sys.exit(axolos_buscar.indexar(aviso=lambda m: print(m, flush=True)))
    elif cmd == "buscar":
        import axolos_buscar
        res = axolos_buscar.Buscador().buscar(" ".join(a[1:]), n=10)
        if not res:
            print(_("No encuentro nada parecido."))
        for r in res:
            ruta = r["ruta"].replace(str(Path.home()), "~")
            print(f"{M}{ruta}{F}" + (f"  {G}" + _("(parecido)") + F if r["parecido"] else ""))
            if r["desc"]:
                print(f"   {G}{r['desc'][:150]}{F}")
    elif cmd == "contexto":
        import axolos_contexto
        print(axolos_contexto.contexto())
    elif cmd == "chat":
        os.execvp("axolos-ia-chat", ["axolos-ia-chat", *a[1:]])
    else:
        print(ayuda())
        sys.exit(0 if cmd in ("-h", "--help", "ayuda") else 1)


if __name__ == "__main__":
    main()
