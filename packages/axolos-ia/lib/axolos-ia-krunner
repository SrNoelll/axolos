#!/usr/bin/env python3
"""AxolOS · KRunner y Bento con la IA local.

  «ia busco una foto de la playa»   busca tus archivos por lo que contienen (índice local)
  «ia …», «axo …», «? …»            pregunta a Axo

D-Bus lo arranca al primer uso y se cierra solo tras 10 minutos sin búsquedas.
"""
import io
import mimetypes
import os
import re
import subprocess
import sys
from pathlib import Path

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

sys.path.insert(0, os.environ.get("AXOLOS_LIB", "/usr/lib/axolos"))

IFACE = "org.kde.krunner1"
SERVICIO = "org.axolos.ia.krunner"
PREGUNTA = re.compile(r"^(?:ia|axo|\?)\s+(.+)$", re.I | re.S)
BUSCAR = re.compile(r"^(?:ia|axo)\s+(?:busc[oa]r?|encuentra(?:me)?|encontrar|d[oó]nde\s+est[aá]n?|"
                    r"ens[eé][nñ]ame|abre(?:me)?)\s+(.+)$", re.I | re.S)
REPOSO_S = 600
SIN = dbus.Array([], signature="s")       # resultados sin acciones extra


def icono_mime(ruta):
    m = mimetypes.guess_type(ruta)[0]
    return m.replace("/", "-") if m else "text-x-generic"


def icon_data(png):
    """Miniatura PNG → (ancho, alto, bytes por fila, alfa, bits, canales, datos) para KRunner."""
    from PIL import Image
    im = Image.open(io.BytesIO(png)).convert("RGBA")
    w, h = im.size
    return dbus.Struct((w, h, w * 4, True, 8, 4, dbus.ByteArray(im.tobytes())), signature="iiibiiay")


class Runner(dbus.service.Object):
    def __init__(self, loop):
        bus = dbus.SessionBus()
        self._nombre = dbus.service.BusName(SERVICIO, bus)
        super().__init__(bus, "/runner")
        self.loop, self.timer, self.buscador = loop, None, None
        self._tocar()

    def _tocar(self):
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add_seconds(REPOSO_S, self.loop.quit)

    def _archivos(self, frase):
        import axolos_buscar as b       # numpy y el índice solo se cargan si se busca
        if self.buscador is None:
            self.buscador = b.Buscador()
        if not b.DB.exists():
            return [("indexar", "Preparar la búsqueda de archivos con IA", "axolos", 50, 0.8,
                     {"subtext": "Aún no hay índice: se crea en segundo plano (axolos-ia indexar)"})]
        try:
            res = self.buscador.buscar(frase, n=8)
        except Exception as e:  # noqa: BLE001  IA apagada o modelo sin descargar
            return [("", f"No se pudo buscar: {e}", "dialog-warning", 50, 0.5, {"subtext": "axolos-ia"})]
        if not res:
            return [(f"Busca en mis archivos: {frase}", f"No encuentro nada parecido a «{frase}»", "axolos",
                     50, 0.5, {"subtext": "Pulsa para preguntárselo a Axo"})]
        out = []
        for i, r in enumerate(res):
            ruta = r["ruta"]
            carpeta = str(Path(ruta).parent).replace(str(Path.home()), "~")
            desc = re.sub(r"\s+", " ", r["desc"] or "").strip()
            sub = (desc[:110] + "…" if len(desc) > 110 else desc)
            sub = (f"{sub} · {carpeta}" if sub else carpeta)
            if r["parecido"]:
                sub = "Lo más parecido · " + sub
            props = {"subtext": sub, "urls": [Path(ruta).as_uri()], "category": "Archivos (IA local)",
                     "actions": ["carpeta"]}
            if r["mini"]:
                try:
                    props["icon-data"] = icon_data(r["mini"])
                except Exception:  # noqa: BLE001  miniatura rota: icono genérico
                    pass
            relev = max(0.1, min(1.0, 0.95 - i * 0.05 - (0.3 if r["parecido"] else 0)))
            out.append((ruta, Path(ruta).name, icono_mime(ruta), 70 if r["parecido"] else 100, relev, props))
        return out

    @dbus.service.method(IFACE, in_signature="s", out_signature="a(sssida{sv})")
    def Match(self, query):
        self._tocar()
        q = str(query).strip()
        m = BUSCAR.match(q)
        if m and len(m.group(1).strip()) > 2:
            return self._archivos(m.group(1).strip())
        m = PREGUNTA.match(q)
        if m and len(m.group(1).strip()) > 1:
            t = m.group(1).strip()
            return [(t, f"Preguntar a Axo: {t}", "axolos", 100, 1.0, {"subtext": "IA local", "actions": SIN})]
        # Frases que parecen preguntas: se ofrece, pero por debajo de apps y ficheros
        if q.endswith("?") and len(q.split()) >= 3:
            return [(q, f"Preguntar a Axo: {q}", "axolos", 30, 0.3, {"subtext": "IA local", "actions": SIN})]
        return []

    @dbus.service.method(IFACE, out_signature="a(sss)")
    def Actions(self):
        return [("carpeta", "Abrir la carpeta que lo contiene", "document-open-folder")]

    @dbus.service.method(IFACE, in_signature="ss")
    def Run(self, data, action_id):
        self._tocar()
        data = str(data)
        sin_salida = dict(start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if data == "indexar":
            subprocess.Popen(["systemctl", "--user", "start", "--no-block", "axolos-indice.service"], **sin_salida)
        elif data.startswith("/") and Path(data).exists():
            if action_id == "carpeta":
                if subprocess.run(["which", "dolphin"], capture_output=True).returncode == 0:
                    subprocess.Popen(["dolphin", "--select", data], **sin_salida)
                else:
                    subprocess.Popen(["xdg-open", str(Path(data).parent)], **sin_salida)
            else:
                subprocess.Popen(["xdg-open", data], **sin_salida)
        elif data:
            subprocess.Popen(["axolos-ia-chat", "--pregunta", data], **sin_salida)

    @dbus.service.method(IFACE)
    def Teardown(self):
        pass


def main():
    DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    Runner(loop)
    loop.run()


if __name__ == "__main__":
    main()
