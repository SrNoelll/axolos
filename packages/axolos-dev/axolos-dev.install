t() { /usr/lib/axolos/axolos-texto "$@" 2>/dev/null || printf '%s\n' "$1"; }   # texto en el idioma del sistema

post_install() {
  # Docker se arranca solo la primera vez que se usa (socket): no gasta nada mientras tanto
  systemctl enable docker.socket >/dev/null 2>&1 || true
  echo ":: AxolOS dev: $(t "«axolos-dev» muestra los perfiles de lenguajes; «axolos-dev editores» pone el tema en VS Code.")"
}

post_upgrade() {
  :
}
