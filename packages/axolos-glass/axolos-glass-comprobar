#!/bin/bash
# AxolOS · salvaguarda del cristal líquido (gancho de pacman, como root).
# Un efecto de KWin compilado para otra versión de KWin o Qt puede tumbar la sesión gráfica. Si no
# coinciden, se aparta el efecto y se vuelve al desenfoque normal de KDE hasta que llegue la versión
# recompilada de axolos-glass (la publicación de AxolOS la recompila sola cuando cambia KWin).
t() { /usr/lib/axolos/axolos-texto "$@" 2>/dev/null || printf '%s\n' "$1"; }   # texto en el idioma del sistema

RECETA=/usr/share/axolos/cristal/compilado-para
SO=/usr/lib/qt6/plugins/kwin/effects/plugins/glass.so
APARTE=/usr/lib/axolos/cristal/glass.so.otra-version
CONF=/etc/xdg/kwinrc
[[ -f $RECETA ]] || exit 0

para_kwin=$(sed -n 's/^kwin //p' "$RECETA"); para_qt=$(sed -n 's/^qt //p' "$RECETA")
# Versión sin época ni pkgrel: «6.12.0-5.1» (CachyOS v3) y «6.12.0-5» (genérico) → 6.12.0
version() { local v; v=$(pacman -Q "$1" 2>/dev/null | awk '{print $2}'); v=${v#*:}; printf '%s' "${v%%-*}"; }
hay_kwin=$(version kwin)                      # KWin exige la versión exacta
hay_qt=$(version qt6-base | cut -d. -f1,2)    # Qt: mayor.menor

plugins() {   # plugins GLASS BLUR: qué efecto usa KWin por defecto ([Plugins] de /etc/xdg/kwinrc)
  [[ -f $CONF ]] || return 0
  sed -i -e "s/^glassEnabled=.*/glassEnabled=$1/" -e "s/^blurEnabled=.*/blurEnabled=$2/" "$CONF"
}

# ¿Tiene este procesador las instrucciones que usa el efecto? Un binario con AVX-512 en un procesador
# sin ellas tumba KWin (SIGILL) nada más cargarlo. Sin objdump no se puede mirar: se da por bueno.
compatible() {
  local so=$1 asm
  [[ -f $so ]] && command -v objdump >/dev/null || return 0
  asm=$(objdump -d --no-show-raw-insn "$so" 2>/dev/null) || return 0
  if grep -q '%zmm[0-9]' <<<"$asm" && ! grep -qw avx512f /proc/cpuinfo; then return 1; fi
  if grep -q '%ymm[0-9]' <<<"$asm" && ! grep -qw avx2 /proc/cpuinfo; then return 1; fi
  return 0
}

# La pantalla de inicio de sesión (SDDM) no usa el cristal de KWin (su refracción va en QML): así un
# efecto que fallase nunca deja sin poder entrar. /etc/xdg/kwinrc lo activa para todos; aquí se
# desactiva solo para la cuenta de SDDM.
sddm_sin_cristal() {
  local casa rc
  casa=$(getent passwd sddm | cut -d: -f6)
  [[ -n $casa && -d $casa ]] && command -v kwriteconfig6 >/dev/null || return 0
  rc=$casa/.config/kwinrc
  install -d -o sddm -g sddm "$casa/.config"
  kwriteconfig6 --file "$rc" --group Plugins --key glassEnabled --type bool false
  kwriteconfig6 --file "$rc" --group Plugins --key blurEnabled --type bool true
  chown sddm:sddm "$rc"
}
sddm_sin_cristal

candidato=$SO; [[ -f $SO ]] || candidato=$APARTE
if [[ $para_kwin == "$hay_kwin" && $para_qt == "$hay_qt" ]] && ! compatible "$candidato"; then
  if [[ -f $SO ]]; then mkdir -p "${APARTE%/*}"; mv -f "$SO" "$APARTE"; fi
  plugins false true
  echo ":: AxolOS: $(t "el cristal líquido se pausa: esta versión usa instrucciones que este procesador no tiene (mientras, desenfoque normal).")"
elif [[ $para_kwin == "$hay_kwin" && $para_qt == "$hay_qt" ]]; then
  [[ ! -f $SO && -f $APARTE ]] && mv -f "$APARTE" "$SO"
  rm -f "$APARTE"
  plugins true false
else
  if [[ -f $SO ]]; then mkdir -p "${APARTE%/*}"; mv -f "$SO" "$APARTE"; fi
  plugins false true
  echo ":: AxolOS: $(t "el cristal líquido se pausa hasta que llegue su versión para KWin {0} (mientras, desenfoque normal)." "$hay_kwin")"
fi
exit 0
