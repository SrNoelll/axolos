# AxolOS · cristal líquido (efecto Glass). Valores por defecto del sistema: cada usuario puede
# cambiarlos en Preferencias del sistema → Efectos del escritorio → Glass.
# Como el Liquid Glass de Apple: centro claro con poco desenfoque, la refracción concentrada en el
# canto (lente), irisado de color en el borde, filo de luz arriba y un tinte que se adapta a lo que
# hay detrás (más denso solo cuando el fondo contrasta, para que el texto se siga leyendo).
[Plugins]
glassEnabled=true
blurEnabled=false

[Effect-blurplus]
BlurStrength=3
BlurFinetune=3
DecorationBlurStrength=3
DockBlurStrength=2
DockBlurFinetune=3
NoiseStrength=0
DecorationNoiseStrength=0
DockNoiseStrength=0
BlurSaturationCompensation=true
Saturation=1.5
BlurMenus=true
BlurDocks=true
BlurDecorations=true
TopCornerRadius=14
BottomCornerRadius=14
MenuCornerRadius=14
DockCornerRadius=18
DynamicCorners=true
DynamicCornersExcludeDocks=true
DynamicCornersExcludeMenus=true
DynamicCornersExcludeTooltips=true
UseWindowPaletteTint=true
AutoTintAlpha=true
AutoTintAlphaMin=0
AutoTintAlphaMax=55
RefractionStrength=12
RefractionEdgeSize=4
RefractionNormalPow=4
RefractionRGBFringing=10
RefractionOffsetStrength=6
RefractionBevelIntensity=13
PhysicallyBasedRefraction=true
BodyRefraction=true
BodyRefractionReach=40
BodyRefractionStrength=25
EdgeLighting=true
EdgeLightingDock=true
RimGlow=true
GlowColor=#38FFFFFF
GlowOffset=-40
RimSpecular=true
RimSpecularScale=10
RimWidth=19
