#!/usr/bin/env bash
# AxolOS · instala la selección de aplicaciones de AxolOS (listas en /usr/share/axolos/pkglists).
# Solo instala lo que falte; lo que no esté en los repositorios se omite.
set -euo pipefail
D=/usr/share/axolos/pkglists
t() { /usr/lib/axolos/axolos-texto "$@" 2>/dev/null || printf '%s\n' "$1"; }   # texto en el idioma del sistema
if [[ $EUID -eq 0 ]]; then
  t "Ejecuta axolos-apps como usuario normal (pedirá sudo)." >&2
  exit 1
fi

echo ":: $(t "Paquetes de los repositorios")"
mapfile -t avail < <(pacman -Slq | sort -u)
mapfile -t want  < <(sort -u "$D/native.txt")
mapfile -t todo  < <(comm -12 <(printf '%s\n' "${want[@]}") <(printf '%s\n' "${avail[@]}"))
missing=$(comm -23 <(printf '%s\n' "${want[@]}") <(printf '%s\n' "${avail[@]}") | tr '\n' ' ')
[[ -n $missing ]] && echo "   $(t "(no están en los repos, se omiten: {0})" "$missing")"
sudo pacman -S --needed "${todo[@]}"

if [[ -s $D/aur.txt ]]; then
  helper=$(command -v paru || command -v yay || true)
  if [[ -n $helper ]]; then
    echo ":: $(t "Paquetes del AUR con {0}" "$(basename "$helper")")"
    grep -vxE 'axolos-.*' "$D/aur.txt" | "$helper" -S --needed -
  else
    echo ":: $(t "No hay paru ni yay. Paquetes del AUR pendientes:")"; sed 's/^/   /' "$D/aur.txt"
  fi
fi
