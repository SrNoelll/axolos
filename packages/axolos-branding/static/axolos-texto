#!/usr/bin/env python3
"""AxolOS · texto en el idioma del sistema para scripts de shell.

  axolos-texto "Texto original" [valor para {0}] [valor para {1}] …

Los textos se extraen con tools/i18n.sh (función «t» de los scripts) y se traducen
en po/*.po como los de los programas en Python.
"""
import os
import sys

sys.path.insert(0, os.environ.get("AXOLOS_LIB", "/usr/lib/axolos"))
try:
    from axolos_i18n import _
except ImportError:
    def _(texto):
        return texto

if len(sys.argv) < 2:
    sys.exit(__doc__)
texto = _(sys.argv[1])
try:
    texto = texto.format(*sys.argv[2:]) if len(sys.argv) > 2 else texto
except (IndexError, KeyError, ValueError):
    texto = sys.argv[1].format(*sys.argv[2:])
print(texto)
