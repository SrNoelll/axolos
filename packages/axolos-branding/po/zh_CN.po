msgstr "（来自 AxolOS：{0}）"

#: packages/axolos-bienvenida/bin/axolos-centro:214
#, python-brace-format
msgid "{0} paquetes por actualizar{extra}."
msgstr "{0} 个软件包待更新{extra}。"

#: packages/axolos-bienvenida/bin/axolos-centro:216
msgid "No se pudo comprobar (¿sin conexión?)."
