msgstr "Graphics acceleration enabled"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:356
#, python-brace-format
msgid "Se activará la aceleración por gráfica ({0})"
msgstr "Graphics acceleration will be enabled ({0})"

