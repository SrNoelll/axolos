#: packages/axolos-bienvenida/bin/axolos-bienvenida:672
msgid "Conectar VS Code con la IA local"
msgstr "Подключить VS Code к локальному ИИ"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:676
msgid "Al final, abrir la conexión con GitHub"
msgstr "В конце открыть подключение к GitHub"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:678
msgid "Nada pendiente: tu equipo ya está al día"
msgstr "Ничего не осталось: всё уже настроено"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:703
msgid "No se pudo completar: "
msgstr "Не удалось завершить: "

#: packages/axolos-bienvenida/bin/axolos-bienvenida:704
msgid ". Puedes volver a abrir «Bienvenida a AxolOS» desde el menú para reintentarlo."
msgstr ". Можно снова открыть «Добро пожаловать в AxolOS» из меню и повторить."

#: packages/axolos-bienvenida/bin/axolos-bienvenida:707
msgid "Para usar Docker sin sudo, cierra sesión y vuelve a entrar."
msgstr "Чтобы пользоваться Docker без sudo, выйдите из сеанса и войдите снова."

#: packages/axolos-bienvenida/bin/axolos-centro:164
msgid "Tu AxolOS"
msgstr "Ваш AxolOS"

#: packages/axolos-bienvenida/bin/axolos-centro:165
msgid "El estado del sistema de un vistazo."
msgstr "Состояние системы с первого взгляда."

#: packages/axolos-bienvenida/bin/axolos-centro:176
msgid "Sistema"
msgstr "Система"

#: packages/axolos-bienvenida/bin/axolos-centro:177
