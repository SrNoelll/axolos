msgstr "Центр AxolOS"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:453
msgid "en el menú: actualizaciones, lenguajes, modelos de IA y apariencia"
msgstr "в меню: обновления, языки, модели ИИ и оформление"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:454
msgid "en la terminal: busca en todo tu historial de comandos"
msgstr "в терминале: поиск по всей истории команд"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:455
msgid "salta a tus carpetas más usadas"
msgstr "переход в часто используемые папки"

#: packages/axolos-bienvenida/bin/axolos-bienvenida:455
msgid "z carpeta"
msgstr "z папка"

