msgstr "(без axolos-desktop)"

#: packages/axolos-bienvenida/bin/axolos-centro:178
#, python-brace-format
msgid "Sobre CachyOS · núcleo {kernel}"
msgstr "На базе CachyOS · ядро {kernel}"

#: packages/axolos-bienvenida/bin/axolos-centro:179
msgid "Equipo"
msgstr "Компьютер"

#: packages/axolos-bienvenida/bin/axolos-centro:180
msgid "Actualizaciones"
msgstr "Обновления"

