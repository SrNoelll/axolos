def sh(*cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def faltan(pkgs):
    return subprocess.run(["pacman", "-T", *pkgs], capture_output=True, text=True).stdout.split()


# --- piezas visuales -----------------------------------------------------------------
class Sello(QWidget):
    """Cuadrado redondeado con un monograma (JS, Py…)."""

    def __init__(self, texto, color, lado=40):
        super().__init__()
        self.texto, self.color = texto, QColor(color)
        self.setFixedSize(lado, lado)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        fondo = QColor(self.color)
        fondo.setAlpha(38)
        p.setBrush(fondo)
        p.setPen(Qt.PenStyle.NoPen)
        p.drawRoundedRect(self.rect(), 11, 11)
        p.setPen(self.color)
        f = QFont(MONO, max(10, int(self.height() * (0.42 if len(self.texto) == 1 else 0.3 if len(self.texto) == 2 else 0.25))))
        f.setBold(True)
        p.setFont(f)
        p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, self.texto)


def titulo(texto, sub=None):
    w = QWidget()
    v = QVBoxLayout(w)
    v.setContentsMargins(0, 0, 0, 0)
    v.setSpacing(6)
    t = QLabel(texto, objectName="titulo")
    v.addWidget(t)
    if sub:
        s = QLabel(sub, objectName="sub")
        s.setWordWrap(True)
        v.addWidget(s)
    return w


class Tarjeta(QFrame):
    cambiada = pyqtSignal()

    def __init__(self, clave, datos, instalado):
        super().__init__(objectName="tarjeta")
        self.clave, self.instalado = clave, instalado
        self.sel = False
        self.setCursor(Qt.CursorShape.ArrowCursor if instalado else Qt.CursorShape.PointingHandCursor)
        self.setProperty("inst", instalado)
        h = QHBoxLayout(self)
        h.setContentsMargins(14, 12, 14, 12)
        h.setSpacing(12)
        mono, color = SELLO.get(clave, (clave[:2].title(), C["accent"]))
        h.addWidget(Sello(mono, color), 0, Qt.AlignmentFlag.AlignTop)
        v = QVBoxLayout()
        v.setSpacing(2)
        fila = QHBoxLayout()
        self.nombre = datos["nombre"]
        n = QLabel(self.nombre)
        n.setStyleSheet("font-weight: 700")
        fila.addWidget(n)
        fila.addStretch(1)
        if instalado:
            ok = QLabel("Instalado", objectName="ok")
            ok.setStyleSheet("font-size: 9pt")
            fila.addWidget(ok)
        v.addLayout(fila)
        d = QLabel(datos["descripcion"], objectName="tenue")
        d.setWordWrap(True)
        d.setStyleSheet("font-size: 9.5pt")
        v.addWidget(d)
        h.addLayout(v, 1)

    def mousePressEvent(self, _):
        if not self.instalado:
            self.poner(not self.sel)
            self.cambiada.emit()

    def poner(self, on):
        self.sel = on
        self.setProperty("sel", on)
        self.style().polish(self)


# --- páginas -------------------------------------------------------------------------
def pagina(margen=(48, 40, 48, 24)):
    w = QWidget(objectName="pagina")
    v = QVBoxLayout(w)
    v.setContentsMargins(*margen)
    v.setSpacing(18)
    return w, v


class Inicio(QWidget):
    def __init__(self, hw):
        super().__init__()
        v = QVBoxLayout(self)
        v.setContentsMargins(48, 70, 48, 24)
        v.setSpacing(16)
        logo = QLabel()
        logo.setPixmap(QIcon.fromTheme("axolos", QIcon("/usr/share/icons/hicolor/scalable/apps/axolos.svg"))
                       .pixmap(96, 96))
        v.addWidget(logo)
        t = QLabel("Bienvenido a AxolOS", objectName="titulo")
        t.setStyleSheet("font-size: 30pt")
        v.addWidget(t)
        s = QLabel("En un par de minutos dejamos tu equipo listo para programar y para usar inteligencia "
                   "artificial en local, sin depender de internet. Elige lo que quieras; lo pesado "
                   "se instala solo al final.", objectName="sub")
        s.setWordWrap(True)
        s.setStyleSheet("font-size: 11.5pt")
        v.addWidget(s)
        v.addSpacing(12)
        fila = QHBoxLayout()
        fila.setSpacing(10)
        cpu = sh("sh", "-c", "LC_ALL=C lscpu | sed -n 's/^Model name: *//p' | head -1")
        cpu = re.sub(r"\(R\)|\(TM\)|CPU|Processor|\s+@.*", "", cpu).strip() or "Procesador"
        gpu = hw["gpu"].replace("NVIDIA GeForce ", "") if hw["gpu"] else "Gráfica integrada"
        for txt in (cpu, f"{hw['ram_gb']:.0f} GB de RAM", gpu + (f" · {hw['vram_gb']:.0f} GB" if hw["vram_gb"] else "")):
            c = QLabel(txt, objectName="chip")
            fila.addWidget(c)
        fila.addStretch(1)
        v.addLayout(fila)
        v.addStretch(1)


class Perfiles(QWidget):
    def __init__(self):
        super().__init__()
        datos = json.loads(PERFILES.read_text(encoding="utf-8"))
        nv = ia.hardware()["vendor"] == "nvidia"
        v = QVBoxLayout(self)
        v.setContentsMargins(48, 40, 48, 24)
        v.setSpacing(18)
        v.addWidget(titulo("¿Con qué vas a programar?",
                           "Marca tus lenguajes y herramientas. Git, Docker, la terminal mejorada y el "
                           "editor ya vienen de serie."))
        grid = QGridLayout()
        grid.setHorizontalSpacing(12)
        grid.setVerticalSpacing(12)
        self.tarjetas = []
        for i, (k, d) in enumerate(datos.items()):
            pk = d["paquetes"] + d.get("paquetes_nvidia" if nv else "paquetes_otros", [])
            t = Tarjeta(k, d, instalado=not faltan(pk))
            self.tarjetas.append(t)
            grid.addWidget(t, i // 2, i % 2)
        cont = QWidget()
        cont.setLayout(grid)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setWidget(cont)
        sc.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        v.addWidget(sc, 1)
        # preselección cuando ya están en la ventana (antes, el estilo no se aplicaba con Kvantum)
        QTimer.singleShot(0, lambda: [t.poner(True) for t in self.tarjetas
                                      if not t.instalado and t.clave in ("web", "python")])

    def elegidos(self):
        return [t.clave for t in self.tarjetas if t.sel and not t.instalado]

    def nombres(self):
        return [t.nombre for t in self.tarjetas if t.sel and not t.instalado]


class Git(QWidget):
    def __init__(self):
        super().__init__()
        v = QVBoxLayout(self)
        v.setContentsMargins(48, 40, 48, 24)
        v.setSpacing(18)
        v.addWidget(titulo("Tu identidad para Git y GitHub",
                           "Con esto firmas tus commits y subes código a GitHub por SSH, sin contraseñas."))
        caja = QFrame(objectName="caja")
        g = QGridLayout(caja)
        g.setContentsMargins(20, 18, 20, 18)
        g.setVerticalSpacing(12)
        g.setHorizontalSpacing(14)
        self.nombre = QLineEdit(sh("git", "config", "--global", "user.name"))
        self.nombre.setPlaceholderText("Tu nombre")
        self.email = QLineEdit(sh("git", "config", "--global", "user.email"))
        self.email.setPlaceholderText("tu@correo.com")
        g.addWidget(QLabel("Nombre"), 0, 0)
        g.addWidget(self.nombre, 0, 1)
        g.addWidget(QLabel("Correo"), 1, 0)
        g.addWidget(self.email, 1, 1)
        v.addWidget(caja)

        self.clave = Path.home() / ".ssh/id_ed25519"
        self.ssh = QCheckBox("Crear una clave SSH para este equipo")
        self.ssh.setChecked(not self.clave.exists())
        if self.clave.exists():
            self.ssh.setText("Ya tienes una clave SSH (~/.ssh/id_ed25519)")
            self.ssh.setEnabled(False)
            self.ssh.setChecked(True)
        conectado = subprocess.run(["gh", "auth", "status"], capture_output=True).returncode == 0 \
            if shutil.which("gh") else False
        self.gh = QCheckBox("Conectar con GitHub al terminar (se abre una terminal y el navegador)")
        self.gh.setChecked(not conectado)
        if conectado:
            self.gh.setText("Ya estás conectado a GitHub")
            self.gh.setEnabled(False)
            self.gh.setChecked(False)
        self.editor = QCheckBox("Poner el tema AxolOS en VS Code")
        self.editor.setChecked(True)
        self.editor.setVisible(any(shutil.which(c) for c in ("code", "codium", "antigravity")))
        self.atuin = QCheckBox("Buscar en tu historial de comandos con Ctrl+R (importa el historial actual)")
        self.atuin.setChecked(shutil.which("atuin") is not None and
                              not (Path.home() / ".local/share/atuin/history.db").exists())
        self.atuin.setVisible(shutil.which("atuin") is not None)
        for cb in (self.ssh, self.gh, self.editor, self.atuin):
            v.addWidget(cb)
        v.addStretch(1)


class IA(QWidget):
    cambiada = pyqtSignal()

    def __init__(self, hw):
        super().__init__()
        self.hw = hw
        v = QVBoxLayout(self)
        v.setContentsMargins(48, 40, 48, 24)
        v.setSpacing(16)
        v.addWidget(titulo("Inteligencia artificial en local",
                           "Modelos que funcionan en tu equipo: sin internet, sin cuotas y sin que nada "
                           "salga de aquí. Los he elegido según tu gráfica."))
        caja = QFrame(objectName="caja")
        h = QHBoxLayout(caja)
        h.setContentsMargins(18, 14, 18, 14)
        gpu = (f"{hw['gpu']} · {hw['vram_gb']:.0f} GB de VRAM" if hw["gpu"] else "Sin gráfica dedicada: irá por procesador")
        h.addWidget(Sello("AI", C["accent"], 36))
        col = QVBoxLayout()
        col.setSpacing(2)
        col.addWidget(QLabel(gpu))
        if hw["backend_ok"]:
            est = QLabel("Aceleración por gráfica activada", objectName="ok")
        else:
            est = QLabel(f"Se activará la aceleración por gráfica ({hw['backend']})", objectName="aviso")
        est.setStyleSheet("font-size: 9.5pt")
        col.addWidget(est)
        h.addLayout(col, 1)
        v.addWidget(caja)

        v.addWidget(QLabel("MODELOS", objectName="seccion"))
        inst = {m["name"].removesuffix(":latest") for m in ia.modelos()}
        rec, opc = ia.recomendados(hw), ia.opcionales(hw)
        self.checks = []
        for m in ia.CATALOGO:
            if m["id"] not in rec and m["id"] not in opc and m["id"] not in inst:
                continue
            fila = QHBoxLayout()
            cb = QCheckBox(f"{m['nombre']}")
            cb.setStyleSheet("font-weight: 600")
            cb.setChecked(m["id"] in rec or m["id"] in inst)
            if m["id"] in inst:
                cb.setEnabled(False)
            cb.toggled.connect(self.cambiada)
            fila.addWidget(cb)
            nota = m["uso"]
            if m["id"] in opc:
                nota += " · opcional, va bien en tu equipo"
            d = QLabel(nota, objectName="tenue")
            fila.addWidget(d, 1)
            fila.addWidget(QLabel("instalado" if m["id"] in inst else f"{m['gb']:.1f} GB", objectName="tenue"))
            v.addLayout(fila)
            self.checks.append((m, cb))
        self.total = QLabel(objectName="tenue")
        v.addWidget(self.total)
        self.vscode = QCheckBox("Conectar VS Code con la IA local (chat y autocompletado con Continue)")
        self.vscode.setChecked(True)
        self.vscode.setVisible(shutil.which("code") is not None)
        v.addSpacing(6)
        v.addWidget(self.vscode)
        v.addStretch(1)
        self.cambiada.connect(self._total)
        self._total()

    def elegidos(self):
        return [m["id"] for m, cb in self.checks if cb.isChecked() and cb.isEnabled()]

    def _total(self):
        gb = sum(m["gb"] for m, cb in self.checks if cb.isChecked() and cb.isEnabled())
        self.total.setText(f"Descarga: {gb:.1f} GB" if gb else "No hay nada que descargar")


