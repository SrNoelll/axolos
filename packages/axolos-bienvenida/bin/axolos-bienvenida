        self.nota.setWordWrap(True)
        v.addWidget(self.nota)
        v.addStretch(1)


# --- ejecución ---------------------------------------------------------------------------
class Ejecutor(QWidget):
    """Lanza los pasos uno tras otro con QProcess y va informando."""
    linea = pyqtSignal(str)
    paso = pyqtSignal(str, int)       # texto, porcentaje global
    fin = pyqtSignal(list)            # pasos que fallaron

    def __init__(self, pasos):
        super().__init__()
        self.pasos, self.i, self.fallos = pasos, -1, []
        self.proc = None

    def empezar(self):
        self._siguiente()

    def _siguiente(self, *_):
        if self.proc is not None:
            ok = self.proc.exitStatus() == QProcess.ExitStatus.NormalExit and self.proc.exitCode() == 0
            if not ok:
                self.fallos.append(self.pasos[self.i][0])
        self.i += 1
        if self.i >= len(self.pasos):
            self.paso.emit("Terminado", 100)
            self.fin.emit(self.fallos)
            return
        texto, cmd = self.pasos[self.i]
        self.paso.emit(texto, int(self.i * 100 / len(self.pasos)))
        self.linea.emit(f"\n$ {' '.join(cmd)}")
        if SIMULAR:
            cmd = ["sh", "-c", "sleep 0.6; echo '(simulado)'"]
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._leer)
        self.proc.finished.connect(self._siguiente)
        self.proc.errorOccurred.connect(self._no_arranca)
        self.proc.start(cmd[0], cmd[1:])

    def _no_arranca(self, err):
        if err == QProcess.ProcessError.FailedToStart:
            self.linea.emit("(no se pudo ejecutar)")
            self.fallos.append(self.pasos[self.i][0])
            self.proc = None
            self._siguiente()

    def _leer(self):
        data = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        for trozo in re.split(r"[\r\n]+", data):
            trozo = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", trozo).strip()
            if not trozo:
                continue
            m = re.search(r"(\d{1,3}) %", trozo)
            if m:
                texto = self.pasos[self.i][0]
                base = self.i * 100 / len(self.pasos)
                self.paso.emit(f"{texto} · {m.group(1)} %", int(base + int(m.group(1)) / len(self.pasos)))
                continue
            self.linea.emit(trozo)


# --- ventana ---------------------------------------------------------------------------
class Asistente(QWidget):
    PASOS = ["Bienvenida", "Programación", "Git y GitHub", "IA local", "Aplicar", "Listo"]

    def __init__(self):
        super().__init__(objectName="raiz")
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        self.setWindowTitle("Bienvenida a AxolOS")
        self.setWindowIcon(QIcon.fromTheme("axolos-bienvenida", QIcon.fromTheme("axolos")))
        self.resize(980, 680)
        self.hw = ia.hardware()
        h = QHBoxLayout(self)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(0)

        lat = QFrame(objectName="lateral")
        lat.setFixedWidth(220)
        lv = QVBoxLayout(lat)
        lv.setContentsMargins(16, 28, 16, 20)
        lv.setSpacing(4)
        marca = QLabel("AxolOS")
        marca.setStyleSheet(f"font-family: '{TITULAR}'; font-size: 16pt; padding: 0 10px 18px 10px;")
        lv.addWidget(marca)
        self.etiquetas = []
        for i, p in enumerate(self.PASOS):
            lb = QLabel(f"{i + 1}   {p}", objectName="paso")
            lv.addWidget(lb)
            self.etiquetas.append(lb)
        lv.addStretch(1)
        priv = QLabel("Nada de esto envía datos a\nninguna parte.", objectName="tenue")
        priv.setStyleSheet("font-size: 8.5pt; padding: 0 10px")
        lv.addWidget(priv)
        h.addWidget(lat)

        derecha = QFrame(objectName="derecha")
        der = QVBoxLayout(derecha)
        der.setContentsMargins(0, 0, 0, 0)
        self.pila = QStackedWidget()
        self.p_inicio, self.p_perf, self.p_git = Inicio(self.hw), Perfiles(), Git()
        self.p_ia, self.p_apl, self.p_listo = IA(self.hw), Aplicar(), Listo()
        for p in (self.p_inicio, self.p_perf, self.p_git, self.p_ia, self.p_apl, self.p_listo):
            self.pila.addWidget(p)
        der.addWidget(self.pila, 1)
        pie = QHBoxLayout()
        pie.setContentsMargins(48, 12, 48, 24)
        self.saltar = QPushButton("Ahora no", objectName="plano")
        self.saltar.clicked.connect(self._ahora_no)
        self.atras = QPushButton("Atrás")
        self.atras.clicked.connect(lambda: self.ir(self.pila.currentIndex() - 1))
        self.sig = QPushButton("Empezar", objectName="principal")
        self.sig.setMinimumWidth(140)
        self.sig.clicked.connect(self._siguiente)
        pie.addWidget(self.saltar)
        pie.addStretch(1)
        pie.addWidget(self.atras)
        pie.addWidget(self.sig)
        der.addLayout(pie)
        h.addWidget(derecha, 1)
        self.ir(int(os.environ.get("AXOLOS_BIENVENIDA_PAGINA", "0")))
        if SIMULAR and self.pila.currentIndex() == 4:       # pruebas: aplicar solo (simulado)
            QTimer.singleShot(800, self._aplicar)

    def ir(self, i):
        i = max(0, min(i, len(self.PASOS) - 1))
        self.pila.setCurrentIndex(i)
        for j, lb in enumerate(self.etiquetas):
            lb.setProperty("estado", "actual" if j == i else "hecho" if j < i else "")
            lb.style().polish(lb)
        self.atras.setVisible(0 < i < 5)
        self.saltar.setVisible(i < 4)
        self.sig.setText({0: "Empezar", 3: "Revisar", 4: "Aplicar", 5: "Cerrar"}.get(i, "Siguiente"))
        if i == 4:
            self._resumen()

    def _siguiente(self):
        i = self.pila.currentIndex()
        if i == 4:
            self._aplicar()
        elif i == 5:
            self.close()
        else:
            self.ir(i + 1)

    def _ahora_no(self):
        HECHO.parent.mkdir(parents=True, exist_ok=True)
        HECHO.write_text("omitida\n")
        self.close()

    # ---- plan
    def _plan(self):
        pasos, root = [], []
        perf = self.p_perf.elegidos()
        if perf:
            root.append(("Instalando " + ", ".join(self.p_perf.nombres()),
                         ["pkexec", ia.ROOT_HELPER, "perfiles", *perf]))
        if not self.hw["backend_ok"]:
            root.append(("Activando la gráfica para la IA", ["pkexec", ia.ROOT_HELPER, "ia-gpu"]))
        elif not ia.servidor_ok():
            root.append(("Encendiendo la IA local", ["pkexec", ia.ROOT_HELPER, "ia-servicio"]))
        pasos += root
        g = self.p_git
        nombre, email = g.nombre.text().strip(), g.email.text().strip()
        if nombre and nombre != sh("git", "config", "--global", "user.name"):
            pasos.append(("Configurando Git", ["git", "config", "--global", "user.name", nombre]))
        if email and email != sh("git", "config", "--global", "user.email"):
            pasos.append(("Configurando Git", ["git", "config", "--global", "user.email", email]))
        if g.ssh.isEnabled() and g.ssh.isChecked():
            pasos.append(("Creando tu clave SSH", ["ssh-keygen", "-q", "-t", "ed25519", "-N", "",
                                                    "-C", email or nombre or os.environ.get("USER", "axolos"),
                                                    "-f", str(g.clave)]))
        datos = json.loads(PERFILES.read_text(encoding="utf-8"))
        for k in perf:
            for cmd in datos[k].get("usuario", []):
                pasos.append((f"Preparando {datos[k]['nombre']}", cmd))
        if g.editor.isVisible() and g.editor.isChecked():
            pasos.append(("Tema AxolOS en los editores", ["axolos-dev", "editores"]))
        if g.atuin.isVisible() and g.atuin.isChecked():
            pasos.append(("Importando tu historial de comandos", ["atuin", "import", "auto"]))
        mods = self.p_ia.elegidos()
        for m in mods:
            pasos.append((f"Descargando {ia.nombre_bonito(m)}", ["axolos-ia", "descargar", m]))
        if self.p_ia.vscode.isVisible() and self.p_ia.vscode.isChecked():
            pasos.append(("Conectando VS Code con la IA", ["axolos-ia", "vscode"]))
        return pasos, perf, mods

    def _resumen(self):
        pasos, perf, mods = self._plan()
        items = []
        if perf:
            items.append("Instalar <b>" + ", ".join(self.p_perf.nombres()) + "</b>")
        if not self.hw["backend_ok"]:
            items.append(f"Activar la aceleración por gráfica (<b>{self.hw['backend']}</b>)")
        if any(c[0] == "ssh-keygen" for _, c in pasos):
            items.append("Crear tu clave SSH")
        if any(c[:3] == ["git", "config", "--global"] for _, c in pasos):
            items.append("Guardar tu nombre y correo en Git")
        if mods:
            gb = sum(ia.POR_ID[m]["gb"] for m in mods if m in ia.POR_ID)
            items.append("Descargar " + ", ".join(f"<b>{ia.nombre_bonito(m)}</b>" for m in mods) + f" ({gb:.1f} GB)")
        if any(c == ["axolos-ia", "vscode"] for _, c in pasos):
            items.append("Conectar VS Code con la IA local")
        if any(c == ["axolos-dev", "editores"] for _, c in pasos):
            items.append("Poner el tema AxolOS en VS Code")
        if self.p_git.gh.isEnabled() and self.p_git.gh.isChecked():
            items.append("Al final, abrir la conexión con GitHub")
        if not items:
            items.append("Nada pendiente: tu equipo ya está al día")
        punto = f'<span style="color:{C["accent"]}">●</span>&nbsp;&nbsp;'
        self.p_apl.resumen.setText("<br><br>".join(punto + t for t in items))

    def _aplicar(self):
        pasos, _, _ = self._plan()
        a = self.p_apl
        for w in (a.paso, a.barra, a.detalles):
            w.show()
        self.sig.setEnabled(False)
        self.atras.hide()
        self.saltar.hide()
        self.ej = Ejecutor(pasos)
        self.ej.linea.connect(a.log.appendPlainText)
        self.ej.paso.connect(lambda t, p: (a.paso.setText(t), a.barra.setValue(p)))
        self.ej.fin.connect(self._terminado)
        self.ej.empezar()

    def _terminado(self, fallos):
        HECHO.parent.mkdir(parents=True, exist_ok=True)
        HECHO.write_text("hecha\n")
        if self.p_git.gh.isEnabled() and self.p_git.gh.isChecked() and not SIMULAR:
            subprocess.Popen(["konsole", "--hold", "-e", "gh", "auth", "login", "-h", "github.com",
                              "-p", "ssh", "-w"], start_new_session=True)
        if fallos:
            self.p_listo.nota.setText("No se pudo completar: " + ", ".join(dict.fromkeys(fallos)) +
                                      ". Puedes volver a abrir «Bienvenida a AxolOS» desde el menú para reintentarlo.")
        if any("contenedores" in c for _, c in self.ej.pasos if c[:3] == ["pkexec", ia.ROOT_HELPER, "perfiles"]):
            self.p_listo.nota.setText((self.p_listo.nota.text() + "\n").lstrip() +
                                      "Para usar Docker sin sudo, cierra sesión y vuelve a entrar.")
        self.sig.setEnabled(True)
        self.ir(5)


def main():
    if "--auto" in sys.argv and HECHO.exists():
        return
    app = QApplication([a for a in sys.argv if a != "--auto"])
    app.setApplicationName("axolos-bienvenida")
    app.setDesktopFileName("org.axolos.bienvenida")
    app.setStyleSheet(QSS)
    w = Asistente()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
